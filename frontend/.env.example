# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/receipts_app"

# Node Environment
NODE_ENV="development"

# Kinde Authentication
# Get these values from your Kinde dashboard: https://kinde.com
KINDE_CLIENT_ID=""
KINDE_CLIENT_SECRET=""
KINDE_ISSUER_URL="https://<your-domain>.kinde.com"
KINDE_SITE_URL="http://localhost:3000"
KINDE_POST_LOGOUT_REDIRECT_URL="http://localhost:3000"
KINDE_POST_LOGIN_REDIRECT_URL="http://localhost:3000"

# Note: When Kinde variables are not set, the app runs in development mode
# with authentication disabled. Set all Kinde variables to enable auth.
