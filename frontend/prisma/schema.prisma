generator client {
  provider             = "prisma-client-js"
  recursive_type_depth = "-1"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Expense {
  id            Int          @id @default(autoincrement())
  priceEach     Decimal      @map("price_each") @db.Decimal
  quantity      Decimal      @db.Decimal
  receiptId     Int          @map("receipt_id")
  receiptTextId Int?         @unique @map("receipt_text_id")
  productId     Int?         @map("product_id")
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt     DateTime     @default(now()) @map("updated_at") @db.Timestamp(6)
  product       Product?     @relation(fields: [productId], references: [id], map: "Expense_product_id_fkey")
  receipt       Receipt      @relation(fields: [receiptId], references: [id], map: "Expense_receipt_id_fkey")
  receiptText   ReceiptText? @relation(fields: [receiptTextId], references: [id], map: "Expense_receipt_text_id_fkey")

  @@map("expense")
}

model ImageFile {
  id           Int           @id @default(autoincrement())
  url          String
  receiptId    Int?          @map("receipt_id")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime      @default(now()) @map("updated_at") @db.Timestamp(6)
  receipt      Receipt?      @relation(fields: [receiptId], references: [id], map: "Image_file_receipt_id_fkey")
  receiptTexts ReceiptText[]

  @@map("image_file")
}

model Product {
  id              Int           @id @default(autoincrement())
  name            String
  weight          Decimal       @db.Decimal
  unitOfMeasure   String        @map("unit_of_measure")
  referenceItemId Int           @map("reference_item_id")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime      @default(now()) @map("updated_at") @db.Timestamp(6)
  expenses        Expense[]
  referenceItem   ReferenceItem @relation(fields: [referenceItemId], references: [id], map: "Product_referenceItemId_fkey")

  @@map("product")
}

model ProductPriceProof {
  id              Int            @id @default(autoincrement())
  name            String?
  quantity        Decimal?       @db.Decimal
  unitOfMeasure   String?        @map("unit_of_measure")
  price           Decimal?       @db.Decimal
  pricePerWeight  Decimal?       @map("price_per_weight") @db.Decimal
  referenceUrl    String?        @map("reference_url")
  screenshot      String?
  createdAt       DateTime?      @default(now()) @map("created_at") @db.Timestamp(6)
  validated       Boolean?
  validatedAt     DateTime?      @default(now()) @map("validated_at") @db.Timestamp(6)
  referenceItemId Int?           @map("reference_item_id")
  referenceItem   ReferenceItem? @relation(fields: [referenceItemId], references: [id])

  @@map("product_price_proof")
}

model Receipt {
  id          Int         @id @default(autoincrement())
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime    @default(now()) @map("updated_at") @db.Timestamp(6)
  receiptDate DateTime?   @map("receipt_date") @db.Timestamp(6)
  expenses    Expense[]
  imageFiles  ImageFile[]

  @@map("receipt")
}

model ReceiptText {
  id          Int       @id @default(autoincrement())
  text        String
  boundingBox String?
  imageFileId Int       @map("image_file_id")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime  @default(now()) @map("updated_at") @db.Timestamp(6)
  expense     Expense?
  imageFile   ImageFile @relation(fields: [imageFileId], references: [id], map: "ReceiptText_image_file_id_fkey")

  @@map("receipt_text")
}

model ReferenceItem {
  id                 Int                  @id @default(autoincrement())
  name               String
  quantity           Decimal              @db.Decimal
  unitOfMeasure      String               @map("unit_of_measure")
  price              Decimal              @db.Decimal
  pricePerWeight     Decimal              @map("price_per_weight") @db.Decimal
  referenceUrl       String?              @map("reference_url")
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt          DateTime             @default(now()) @map("updated_at") @db.Timestamp(6)
  products           Product[]
  product_conversion product_conversion[]
  productPriceProofs ProductPriceProof[]

  @@map("reference_item")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model product_conversion {
  id                Int            @id @default(autoincrement())
  reference_item_id Int?
  from_unit         String
  to_unit           String
  factor            Decimal        @db.Decimal
  reference_item    ReferenceItem? @relation(fields: [reference_item_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([reference_item_id, from_unit, to_unit])
}
