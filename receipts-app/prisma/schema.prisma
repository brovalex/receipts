generator client {
  provider             = "prisma-client-js"
  recursive_type_depth = "-1"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Receipt {
  id         Int         @id @default(autoincrement())
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  expenses   Expense[]
  imageFiles ImageFile[]
}

model Expense {
  id            Int          @id @default(autoincrement())
  priceEach     Float
  quantity      Float
  receiptId     Int
  receiptTextId Int?         @unique
  productId     Int?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  product       Product?     @relation(fields: [productId], references: [id])
  receiptText   ReceiptText? @relation(fields: [receiptTextId], references: [id])
  receipt       Receipt      @relation(fields: [receiptId], references: [id])
}

model Product {
  id              Int           @id @default(autoincrement())
  name            String
  weight          Float
  unitOfMeasure   String
  referenceItemId Int
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  expenses        Expense[]
  referenceItem   ReferenceItem @relation(fields: [referenceItemId], references: [id])
}

model ReceiptText {
  id          Int       @id @default(autoincrement())
  text        String
  boundingBox String?
  imageFileId Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  expense     Expense?
  imageFile   ImageFile @relation(fields: [imageFileId], references: [id])
}

model ImageFile {
  id           Int           @id @default(autoincrement())
  url          String
  receiptId    Int?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  receipt      Receipt?      @relation(fields: [receiptId], references: [id])
  receiptTexts ReceiptText[]
}

model ReferenceItem {
  id             Int       @id @default(autoincrement())
  name           String
  quantity       Float
  unitOfMeasure  String
  price          Float
  pricePerWeight Float
  referenceUrl   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  products       Product[]
}

model ProductPriceProof {
  id                Int     @id @default(autoincrement())
  name              String?
  quantity          String?
  unitOfMeasure     String?
  price             Float?
  pricePerWeight    Float?
  referenceURL      String?
  screenshot        String?
  createdAt         String?
  reference_item_id Int?
}
